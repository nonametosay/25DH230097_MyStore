@model _25DH230097_MyStore.Models.ViewModel.GioHang.Cart
@{
    ViewBag.Title = "Giỏ hàng";
    Layout = "~/Views/Shared/_Layout.cshtml";


}
<style>
    .shoppingcart{
        background-color:ghostwhite;
    }
    .cart-section{
        background-color: white;
        border: 1px groove #ffffff;
        border-radius:10px;
        padding: 10px 5px;
        margin: 10px;
    }
    .cart-button{
        width: 250px;
        border: 1px solid #808080;
        margin: 5px;
    }

    .shoppingcart{
        font-size:smaller;
    }
</style>

<h2>GIỎ HÀNG</h2>
<div class="shoppingcart">
    @if (!Model.Items.Any()) { 
    <p>Bạn chưa có sản phẩm nào trong giỏ</p>
    }

else
            {
                <div class="col-md-8 cart-section">
                    @foreach (var categoryGroup in Model.GroupedItems)
                {
                        <h3>@categoryGroup.Key</h3>
                        <table class="table cart-section">
                            <thead>
                                <tr>
                                    <th colspan="2">Sản phẩm</th>
                                    <th>Số lượng</th>
                                    <th>Đơn giá</th>
                                    <th>Thành tiền</th>
                                    <th title="Xóa tất cả mặt hàng trong giỏ">
                                        <a href="@Url.Action("ClearCart","Cart", null)"><i class="fas fa-trash-alt" style="max-height:20px"></i></a>
                                    </th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in categoryGroup)
                                {
                                    <tr>
                                        <td><img src="@Url.Content(item.ProductImage)" alt="@item.ProductName" style="max-height:80px" /></td>
                                        <td class="col-md-3">@item.ProductName</td>
                                        <td>
                                            @using (Html.BeginForm("UpdateQuantity", "Cart", FormMethod.Post))
                                            {

                                                <input type="hidden" name="id" value="@item.ProductID" />
                                                <button type="button" style="width:20px" onclick="cartUpdateQuantity(@item.ProductID,@item.Quantity-1)">-</button>
                                                <input type="number" name="quantity" value="@item.Quantity" min="1" max="100" style="width: 40px;text-align: right;" readonly />
                                                <button type="button" style="width:20px" onclick="cartUpdateQuantity(@item.ProductID,@item.Quantity+1)">+</button>
                                            }
                                        </td>
                                        <td>@item.UnitPrice.ToString("N0")</td>
                                        <td>@item.TotalPrice.ToString("N0")</td>
                                        <td><a href="@Url.Action("RemoveFromCart", "Cart", new {id= item.ProductID})"><i class="fas fa-trash-alt" style="max-height:20px"></i></a></td>
                                    </tr>

                                }
                            </tbody>
                        </table>
                }
                    
                </div>

                <div class="col-md-3 cart-section">
                    <div><strong>Tổng giá trị:&nbsp;<span style="color:red;">@Model.TotalValue().ToString("N0")</span></strong></div>
                    <div>@Html.ActionLink("Mua hàng", "Checkout", "Order", null, new {@class="btn btn-danger cart-button"})</div>
                </div>
            }
</div>
<div class="col-md-12">@Html.ActionLink("Tiếp tục mua hàng", "Index", "Home", null, new {@class="btn btn-warning cart-button"})</div>

@section Scripts {
    
    <script>
        function cartUpdateQuantity(id, newQuantity) {
    // 1. Nếu số lượng mới nhỏ hơn 1 thì dừng luôn (không cho âm)
    if (newQuantity < 1) return;

    // 2. Tạo một thẻ <form> ảo bằng JS
    const form = document.createElement('form');
    form.method = 'post'; // Gửi bằng phương thức POST
    // Lấy đường dẫn đến hàm UpdateQuantity trong CartController
    form.action = '@Url.Action("UpdateQuantity", "Cart")';

    // 3. Tạo một thẻ <input> ẩn để chứa ID sản phẩm
    const idInput = document.createElement('input');
    idInput.type = 'hidden';
    idInput.name = 'id'; // Tên biến Controller sẽ nhận
    idInput.value = id;  // Gán ID sản phẩm
    form.appendChild(idInput); // Nhét input vào form

    // 4. Tạo một thẻ <input> ẩn để chứa Số lượng mới
    const quantityInput = document.createElement('input');
    quantityInput.type = 'hidden';
    quantityInput.name = 'quantity'; // Tên biến Controller sẽ nhận
    quantityInput.value = newQuantity; // Gán số lượng mới
    form.appendChild(quantityInput);

    // 5. Gắn form ảo vào trang web và submit nó
    document.body.appendChild(form);
    form.submit();
}
    </script>
    
    }

