@model _25DH230097_MyStore.Models.ViewModel.LoginVM

@{
    ViewBag.Title = "Login";
    Layout = "~/Views/Shared/_Layout.cshtml";
}


<div>
    @using (Html.BeginForm("Login", "Account", FormMethod.Post, new { role = "form" }))
    {
        @Html.AntiForgeryToken()
        @Html.ValidationSummary(true, "", new { @class = "text-danger" })
        //Tên đăng nhập
        <div>
            @Html.LabelFor(model => model.Username, new { @class = "control-label col-md-2" })
            <div class="col-md-4">
                @Html.TextBoxFor(m => m.Username, new { @class = "control-label col-md-6" })
                @Html.ValidationMessageFor(m => m.Username,"", new {@class="text-danger"})
            </div>
        </div>

        //mật khẩu
        <div>
            @Html.LabelFor(model => model.Password, new { @class = "control-label col-md-2" })
            <div class="col-md-4">
                @Html.PasswordFor(m => m.Password, new { @class = "control-label col-md-6 text-danger",id="password" })
                <button type="button" class="btn btn-outline-secondary" onclick="togglePassword('password',this)" tabindex="-1">👁️</button>
                @Html.ValidationMessageFor(m => m.Password, "", new { @class = "text-danger" })
            </div>
        </div>

        <div>
            <div class="col-md-4">
                <input type="submit" value="Đăng nhập" class="btn btn-info" />
                <p>Bạn Chưa có Tài Khoản? <a href="@Url.Action("Register","Account",null)">Đăng Ký</a></p>
            </div>
        </div>
    }
</div>

@section Scripts{
    <script>
        function togglePassword(inputID, button) {
            var input = document.getElementById(inputID);
            if (input.type === 'password') {
                input.type = 'text';
                button.innerHTML = '🙈';
            } else {
                input.type = 'password';
                button.innerHTML = '👁️';
            }
        }
    </script>
    }

