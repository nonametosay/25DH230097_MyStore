@model _25DH230097_MyStore.Models.ViewModel.ChangePasswordVM

@{
    ViewBag.Title = "ChangePassword";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
@if (ViewBag.SuccessMessage != null)
{
    <div class="alert alert-success">
        @ViewBag.SuccessMessage
    </div>
}
@using (Html.BeginForm("ChangePassword", "Account", FormMethod.Post, new { role = "form" }))
{
    @Html.AntiForgeryToken()
    @Html.ValidationSummary(true, "", new { @class = "text-danger" })
    //Mật khẩu cũ
    <div>
        @Html.LabelFor(model => model.OldPassword, new { @class = "control-label col-md-2" })
        <div class="col-md-4">
            @Html.PasswordFor(m => m.OldPassword, new { @class = "control-label col-md-6", id="OldPassword" })
            <button type="button" class="btn btn-outline-secondary" tabindex="-1" onclick="togglePassword('OldPassword',this)">👁️</button>
            @Html.ValidationMessageFor(m => m.OldPassword, "", new { @class = "text-danger" })
        </div>
    </div>

    //mật khẩu mới
    <div>
        @Html.LabelFor(model => model.NewPassword, new { @class = "control-label col-md-2" })
        <div class="col-md-4">
            @Html.PasswordFor(m => m.NewPassword, new { @class = "control-label col-md-6 text-danger", id="NewPassword" })
            <button type="button" class="btn btn-outline-secondary" onclick="togglePassword('NewPassword',this)" tabindex="-1">👁️</button>
            @Html.ValidationMessageFor(m => m.NewPassword, "", new { @class = "text-danger" })
        </div>
    </div>

    //Xác nhận mật khẩu mới
    <div>
        @Html.LabelFor(model => model.ConfirmNewPassword, new { @class = "control-label col-md-2" })
        <div class="col-md-4">
            @Html.PasswordFor(m => m.ConfirmNewPassword, new { @class = "control-label col-md-6 text-danger", id="ConfirmNewPassword" })
            <button type="button" class="btn btn-outline-secondary" onclick="togglePassword('ConfirmNewPassword',this)" tabindex="-1">👁️</button>
            @Html.ValidationMessageFor(m => m.ConfirmNewPassword, "", new { @class = "text-danger" })
        </div>
    </div>

    <div>
        <div class="col-md-4">
            <input type="submit" value="Đổi mật khẩu" class="btn btn-info" />

        </div>
    </div>
}
</div>
@section Scripts{
    <script>
        function togglePassword(inputId, button) //Nhờ vào button mà ko cần phải tạo id cho button vì có this
        {
            //1. Tìm ô input dựa vào inputId
            var input = document.getElementById(inputId);
            //2. Kiểm tra xem ô input đang ở chế độ password hay text
            if (input.type === 'password') {
                input.type = 'text'; //Chuyển sang chế độ text
                button.innerHTML = '🙈'; //Đổi icon
            }
            else {

                input.type = 'password'; //Chuyển sang chế độ password
                button.innerHTML = '👁️'; //Đổi icon
            }
        }
    </script>
    
    } 


