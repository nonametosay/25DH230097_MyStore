@model _25DH230097_MyStore.Models.ViewModel.HomeProductVM


<link rel="stylesheet" type="text/css" href="~/Content/Home/CustomerHome.css" />

<!-- Hiển thị danh sách sản phẩm -->
@if (Model.FeaturedProducts != null && Model.FeaturedProducts.Any())
{
    <section class="container-fluid featureProd">
        <h2>Sản phẩm nổi bật</h2>
        <div class="feature-container">
            @foreach (var product in Model.FeaturedProducts)
            {
                <div class="fprod-item">
                    <div>
                        <a href="@Url.Action("ProductDetails", "Home", new { id = product.ProductID })">
                            <img src="@Url.Content(product.ProductImage)" />
                        </a>
                    </div>
                    <div>
                        <p class="prodPrice">
                            @String.Format("{0:N0} VNĐ", product.ProductPrice)
                        </p>
                        <p class="prodName">
                            @Html.DisplayFor(modelItem => product.ProductName)
                        </p>
                        <p class="prodCate">
                            @Html.DisplayFor(modelItem => product.Category.CategoryName)
                        </p>
                        <p class="prodSale">
                            Đã bán:&nbsp; @Html.DisplayFor(modelItem => product.OrderDetails.Count)
                        </p>
                    </div>
                </div>
            }
        </div>
    </section>
    <hr />
}