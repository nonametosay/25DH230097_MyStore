@model _25DH230097_MyStore.Models.ViewModel.ProductDetailsVM

<link rel="stylesheet" type="text/css" href="~/Content/Home/myStyle.css" />

<div class="container-fluid pro">
    <div class="row">

        @* Khối bên trái: Ảnh *@
        <div class="col-md-3 pro-section">
            <img src="@Url.Content(Model.product.ProductImage)" class="img-responsive" alt="@Model.product.ProductName" />
        </div>

        @* Khối ở giữa: Thông tin *@
        <div class="col-md-5 pro-section">
            <div>
                <h4><strong>@Html.DisplayFor(model => model.product.ProductName)</strong></h4>
                <p class="pro-sale">Đã bán:&nbsp; @Model.product.OrderDetails.Count</p>
                <p class="pro-price">@Model.product.ProductPrice.ToString("C")</p>
                <p>Tủ sách:&nbsp; @Model.product.Category.CategoryName</p>
                <hr />
                <h5><strong>Mô tả</strong></h5>
                <p>@Model.product.ProductDescription</p>
            </div>
            <hr />

            @* Khối Related Product *@
            <div>@Html.Partial("_PVRelatedProduct", Model)</div>
        </div>

        @* Khối bên phải: Form giỏ hàng *@
        <div class="col-md-3 pro-section">
            <div class="form-group">
                @using (Html.BeginForm("AddToCart", "Cart", FormMethod.Post))
                {
                    <input type="hidden" name="id" value="@Model.product.ProductID" />

                    <h4><strong>Số lượng</strong></h4>
                    <p>
                        @Html.TextBoxFor(model => model.quantity, new
                        {
                            @class = "form-control",
                            @id = "quantityInput",
                            @type = "number",
                            @min = 1,
                            @max = 10
                        })
                        @Html.ValidationMessageFor(model => model.quantity, "", new { @class = "text-danger" })
                    </p>

                    <h4><strong>Tạm tính</strong></h4>
                    @* ĐÃ THÊM id="totalPrice" *@
                    <p id="totalPrice">@Model.estimatedValue.ToString("N0")</p>

                    <p>
                        <button type="submit" class="btn-add-to-cart">Thêm vào giỏ hàng</button>
                    </p>
                }
                <hr />
            </div>

            @* Khối TopProduct *@
            <div>@Html.Partial("_PVTopProduct", Model)</div>
        </div>

    </div>
</div>

@section scripts{
    <script>
        var input = document.getElementById("quantityInput");
        var text  = document.getElementById("totalPrice");

        
        var price = @Model.product.ProductPrice;

        input.addEventListener("input", function () {
            // Tối thiểu 1
            if (input.value < 1 || input.value === "") input.value = 1;
            // Tối đa 10
            if (input.value > 10) input.value = 10;

            var qty = parseInt(input.value) || 1;
            var money = qty * price;
            text.innerHTML = money.toFixed(2) + " VNĐ";
        })
    </script>
}