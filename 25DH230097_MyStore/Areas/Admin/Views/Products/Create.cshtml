@model _25DH230097_MyStore.Models.Product

@{
    ViewBag.Title = "Create";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<h2>THÊM SẢN PHẨM </h2>


@using (Html.BeginForm("Create", "Products", FormMethod.Post, new { enctype = "multipart/form-data" }))
{
    @Html.AntiForgeryToken()

    <div class="form-horizontal">

        <hr />
        @Html.ValidationSummary(true, "", new { @class = "text-danger" })
        @Html.Partial("PVCreateEditProduct", Model)
    </div>
    
        <div class="col-md-offset-2 col-md-10">
            <input type="submit" value="Tạo" class="btn btn-primary btn-sm mb-2" />
            @Html.ActionLink("Quay về", "Index", null, new { @class = "btn btn-primary btn-sm mb-2" })
        </div>
        }



        @section Scripts {
            @Scripts.Render("~/bundles/jqueryval")
        }
