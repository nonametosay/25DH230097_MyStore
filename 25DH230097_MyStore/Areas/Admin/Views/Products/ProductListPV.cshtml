@model _25DH230097_MyStore.Models.ViewModel.SearchProductVM
@using PagedList.Mvc
<head>
    <style>
        img {
            height: 150px;
            max-width: 150px;
        }
    </style>
</head>
@if (Model.Products != null && Model.Products.Any())
{<h2 class="container-fluid">DANH SÁCH SẢN PHẨM</h2>


    <table class="table table-info container-fluid">
        <tr class="table-success">
            <th class="col-md-2">
                Hình ảnh

            </th>
            <th class="col-md-2">
                Tên sản phẩm
            </th>

            <th class="col-md-2">
                Đơn giá
            </th>
            <th class="col-md-2">
                Danh mục
            </th>
            <th class="col-md-2"></th>
        </tr>

        @foreach (var item in Model.Products)
        {
            <tr>
                <td>
                    <img src="@Html.DisplayFor(modelItem => item.ProductImage)" />
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.ProductName)
                </td>

                <td>
                    @Html.DisplayFor(modelItem => item.ProductPrice)
                </td>

                <td>
                    @Html.DisplayFor(modelItem => item.Category.CategoryName)
                </td>
                <td>
                    @Html.ActionLink("Sửa", "Edit", new { id = item.ProductID }, new { @class = "btn btn-primary btn-sm" })
                    @Html.ActionLink("Chi tiết", "Details", new { id = item.ProductID }, new { @class = "btn btn-primary btn-sm" })
                    @Html.ActionLink("Xóa", "Delete", new { id = item.ProductID }, new { @class = "btn btn-primary btn-sm" })
                </td>
            </tr>
        }

    </table>
    //Hiển thị phân trang
    <div class="pagination-lg btn-primary" >
        @Html.PagedListPager(Model.Products, page => Url.Action("Index", new {page,searchTerm=Model.SearchTerm,minPrice=Model.MinPrice,maxPrice = Model.MaxPrice,sortOrder=Model.SortOrder}))
    </div>
}
else
{
    <p> Không tìm thấy sản phẩm nào phù hợp</p>
}

<p>
    @Html.ActionLink("THÊM MỚI", "Create", null, new { @class = "btn btn-primary btn-sm" })
<p />