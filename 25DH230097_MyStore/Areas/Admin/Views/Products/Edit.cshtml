@model _25DH230097_MyStore.Models.Product

@{
    ViewBag.Title = "Edit";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<h2>SỬA SẢN PHẨM</h2>


@using (Html.BeginForm("Edit", "Products", FormMethod.Post, new { enctype = "multipart/form-data" }))
{
    @Html.AntiForgeryToken()
    
<div class="form-horizontal">
    <hr />
    @Html.ValidationSummary(true, "", new { @class = "text-danger" })
    @Html.HiddenFor(model => model.ProductID)
    @Html.HiddenFor(model=>model.ProductImage)
    @Html.Partial("PVCreateEditProduct", Model)
</div>
<div class="col-md-offset-2 col-md-10">
    <input type="submit" value="Sửa" class="btn btn-primary btn-sm mb-2" />
    @Html.ActionLink("Quay về", "Index", null, new { @class = "btn btn-primary btn-sm mb-2" })
</div>
}



@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}
