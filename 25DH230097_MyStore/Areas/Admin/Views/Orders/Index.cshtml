@model IEnumerable<_25DH230097_MyStore.Models.Order>
@{
    ViewBag.Title = "Quản lý Đơn hàng";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<h2>Danh sách Đơn hàng</h2>
<p>
    @Html.ActionLink("Xem danh sách Đơn hàng mới", "Index", null, new { @class = "btn btn-default" })
</p>

<table class="table table-bordered table-hover">
    <thead>
        <tr>
            <th>Mã Đơn</th>
            <th>Khách Hàng</th>
            <th>Ngày Đặt</th>
            <th>Tổng Tiền</th>
            <th>Trạng Thái</th>
            <th style="width: 150px;">Hành Động</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.OrderID</td>
                <td>@(item.Customer != null ? item.Customer.CustomerName : "N/A")</td>
                <td>@item.OrderDate.ToString("dd/MM/yyyy HH:mm")</td>
                <td style="color: red; font-weight: bold;">@item.TotalAmount.ToString("N0") ₫</td>
                <td>@item.PaymentStatus</td>
                <td>
                    @Html.ActionLink("Chi tiết", "Details", new { id = item.OrderID }, new { @class = "btn btn-info btn-sm" }) |
                    @Html.ActionLink("Xóa", "Delete", new { id = item.OrderID }, new { @class = "btn btn-danger btn-sm", onclick = "return confirm('Bạn có chắc chắn muốn xóa đơn hàng này?');" })
                </td>
            </tr>
        }
    </tbody>
</table>