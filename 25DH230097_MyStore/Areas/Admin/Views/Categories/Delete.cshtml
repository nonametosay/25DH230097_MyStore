@model _25DH230097_MyStore.Models.Category

@{
    ViewBag.Title = "Delete";
    Layout = "~/Areas/Admin/Views/Shared/_AdminLayout.cshtml";
}

<h2 >XÓA DANH MỤC</h2>

<h3 class="bg-danger">Bạn có chắc chắn xóa muốn mục này?</h3>
<hr/>
    @using (Html.BeginForm())
    {
        @Html.AntiForgeryToken()
      
<div class="form-group">
    <div class="control-label col-md-2"> Tên danh mục</div>
    @* Giá trị của trường CategoryName *@
    <div class="col-md-10"> @Html.DisplayFor(model => model.CategoryName)</div>


    <div class="form-group">
        <div class="col-md-offset-2 col-md-10">
            <input type="submit" value="Xóa" class="btn btn-primary" />
            @Html.ActionLink("Quay lại danh sách", "Index", null, new { @class = "btn btn-primary btn-sm" })
        </div>
    </div>

    </div>
    }
    